{
  "name": "dsh-wiztree",
  "version": "0.2.1",
  "description": "DeepSeek Harness dual-face plugin: WizTree snapshot analysis tools (diff / query / verify-delete) that write clickable Markdown reports, plus click-to-open-in-File-Explorer for local paths in the transcript.",
  "license": "MIT",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build:client": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check && node --check lib/index.js && node --test \"tests/*.test.mjs\"",
    "sync-skill": "node tools/sync-scripts.mjs",
    "verify-skill-sync": "node tools/sync-scripts.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wiztree",
    "disk-cleanup",
    "explorer",
    "reveal"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  }
}
