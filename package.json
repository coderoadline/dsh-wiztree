{
  "name": "dsh-wiztree",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: WizTree snapshot analysis tools (diff / query / verify-delete) plus one-click open-in-Explorer for file paths in the chat.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build:client": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check && node --check lib/index.js && node --check lib/install.js && node --test \"tests/*.test.mjs\"",
    "sync-skill": "node tools/sync-scripts.mjs",
    "verify-skill-sync": "node tools/sync-scripts.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wiztree",
    "disk-cleanup",
    "explorer",
    "reveal"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
